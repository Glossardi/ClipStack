{
  "name": "clipstack",
  "version": "1.1.2",
  "description": "A minimalist macOS clipboard manager",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "ci:version-check": "./scripts/check-version-sync.sh",
    "ci:preflight": "./scripts/ci-preflight.sh",
    "release:preflight": "./scripts/release-preflight.sh",
    "test": "node --test src/lib/updater.test.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri",
    "build:macos:app": "npm run tauri build -- --bundles app --config '{\"bundle\":{\"createUpdaterArtifacts\":false}}'",
    "build:macos:dmg": "npm run build:macos:app && ./scripts/build-dmg.sh"
  },
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
